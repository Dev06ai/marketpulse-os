<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_surface"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/notif_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/kyvoriq_emblem_intro_tight"
            android:scaleType="fitCenter"
            android:contentDescription="KYVORIQ emblem"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="9dp">
            <ImageView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:scaleType="fitStart"
                android:src="@drawable/kyvoriq_concentric_wordmark"
                android:contentDescription="KYVORIQ"/>
            <ImageView
                android:layout_width="102dp"
                android:layout_height="14dp"
                android:src="@drawable/kyvoriq_trade_the_plot"
                android:scaleType="fitCenter"
                android:contentDescription="Trade the Plot"/>
        </LinearLayout>
        <TextView
            android:id="@+id/notif_chip"
            android:layout_width="68dp"
            android:layout_height="28dp"
            android:text="LIVE"
            android:textColor="#111215"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/notif_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Secure monitoring active"
        android:textColor="#F4F5F7"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="BTC / USDT · Alerts enabled"
        android:textColor="#B7B7BA"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"/>
    <ProgressBar
        android:id="@+id/notif_pulse"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/kyvoriq_gold"/>
</LinearLayout>
