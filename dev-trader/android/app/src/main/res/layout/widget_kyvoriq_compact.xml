<?xml version="1.0" encoding="utf-8"?>
<!-- Slim 4x1 home-screen price card; supports launcher widget resizing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_kyvoriq_surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:src="@drawable/kyvoriq_emblem_static"
            android:scaleType="fitCenter"
            android:contentDescription="KYVORIQ gold emblem"/>
        <ImageView
            android:layout_width="110dp"
            android:layout_height="26dp"
            android:layout_marginStart="7dp"
            android:src="@drawable/kyvoriq_concentric_wordmark"
            android:scaleType="fitCenter"
            android:contentDescription="KYVORIQ geometric wordmark"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text=""/>
        <TextView
            android:id="@+id/widget_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:text="WAIT"
            android:textColor="#D6B575"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textSize="9sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="BTC"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="#F4F5F6"
            android:textSize="17sp"/>
        <ViewFlipper
            android:id="@+id/widget_price_flipper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:inAnimation="@anim/widget_price_in"
            android:outAnimation="@anim/widget_price_out"
            android:animateFirstView="false">
            <TextView
                android:id="@+id/widget_price_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeMaxTextSize="21sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="#F4F5F6"
                android:text="—"/>
            <TextView
                android:id="@+id/widget_price_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeMaxTextSize="21sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="#F4F5F6"
                android:text="—"/>
        </ViewFlipper>
        <TextView
            android:id="@+id/widget_delta"
            android:layout_width="17dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="•"
            android:textColor="#D6B575"
            android:textSize="10sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_bias"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="WAIT"
            android:textColor="#D6B575"
            android:textSize="9sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
