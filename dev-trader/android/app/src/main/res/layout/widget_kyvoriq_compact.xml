<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:background="@drawable/widget_kyvoriq_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="29dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/kyvoriq_emblem_intro_tight" android:scaleType="fitCenter" android:contentDescription="KYVORIQ"/>
        <ImageView android:layout_width="0dp" android:layout_height="25dp" android:src="@drawable/kyvoriq_concentric_wordmark" android:scaleType="fitCenter" android:contentDescription="KYVORIQ" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/widget_health" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYNCING" android:textColor="#C59D62" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingVertical="5dp" android:contentDescription="Open connection details"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
        <TextView android:id="@+id/widget_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BTC" android:textColor="#F4F5F7" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        <ViewFlipper android:id="@+id/widget_price_flipper" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="7dp" android:inAnimation="@anim/widget_price_in" android:outAnimation="@anim/widget_price_out" android:animateFirstView="false">
            <TextView android:id="@+id/widget_price_0" android:layout_width="match_parent" android:layout_height="match_parent" android:text="—" android:textColor="#C59D62" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_price_1" android:layout_width="match_parent" android:layout_height="match_parent" android:text="—" android:textColor="#C59D62" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
        </ViewFlipper>
        <TextView android:id="@+id/widget_delta" android:layout_width="17dp" android:layout_height="match_parent" android:text="•" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_alerts" android:layout_width="48dp" android:layout_height="27dp" android:text="Alerts" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:background="@drawable/notification_logo_bg" android:paddingHorizontal="7dp" android:contentDescription="Open Alerts"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_bias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scanning" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
</LinearLayout>
