<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="9dp" android:background="@drawable/widget_kyvoriq_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/kyvoriq_emblem_intro_tight" android:scaleType="fitCenter" android:contentDescription="KYVORIQ"/>
        <ImageView android:layout_width="0dp" android:layout_height="25dp" android:src="@drawable/kyvoriq_concentric_wordmark" android:scaleType="fitCenter" android:contentDescription="KYVORIQ" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/widget_health" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYNCING" android:textColor="#C59D62" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingVertical="7dp" android:contentDescription="Open connection details"/>
    </LinearLayout>
    <ImageView android:layout_width="100dp" android:layout_height="15dp" android:src="@drawable/kyvoriq_trade_the_plot" android:scaleType="fitCenter" android:contentDescription="KYVORIQ" android:layout_gravity="center_horizontal"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/widget_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BTC" android:textColor="#F4F5F7" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        <ViewFlipper android:id="@+id/widget_price_flipper" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="7dp" android:inAnimation="@anim/widget_price_in" android:outAnimation="@anim/widget_price_out" android:animateFirstView="false">
            <TextView android:id="@+id/widget_price_0" android:layout_width="match_parent" android:layout_height="match_parent" android:text="—" android:textColor="#C59D62" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_price_1" android:layout_width="match_parent" android:layout_height="match_parent" android:text="—" android:textColor="#C59D62" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"/>
        </ViewFlipper>
        <TextView android:id="@+id/widget_delta" android:layout_width="17dp" android:layout_height="match_parent" android:text="•" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_bias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scanning" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_state" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Scanning" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1"/>
        <TextView android:id="@+id/widget_pnl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P&amp;L  —" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widget_chart" android:layout_width="0dp" android:layout_height="28dp" android:text="Chart" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:background="@drawable/notification_logo_bg" android:paddingHorizontal="7dp" android:contentDescription="Open Chart" android:layout_weight="1" android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/widget_alerts" android:layout_width="0dp" android:layout_height="28dp" android:text="Alerts" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:background="@drawable/notification_logo_bg" android:paddingHorizontal="7dp" android:contentDescription="Open Alerts" android:layout_weight="1" android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/widget_positions" android:layout_width="0dp" android:layout_height="28dp" android:text="Positions" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:background="@drawable/notification_logo_bg" android:paddingHorizontal="7dp" android:contentDescription="Open Positions" android:layout_weight="1" android:layout_marginEnd="4dp"/>
    </LinearLayout>
</LinearLayout>
