<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/notification_surface" android:paddingHorizontal="10dp" android:paddingVertical="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/notif_logo" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/kyvoriq_emblem_intro_tight" android:scaleType="fitCenter" android:contentDescription="KYVORIQ"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="9dp">
            <ImageView android:id="@+id/notif_title" android:layout_width="match_parent" android:layout_height="22dp" android:src="@drawable/kyvoriq_concentric_wordmark" android:scaleType="fitCenter" android:contentDescription="KYVORIQ"/>
            <TextView android:id="@+id/notif_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Secure monitoring active" android:textColor="#F4F5F7" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/notif_chip" android:layout_width="62dp" android:layout_height="24dp" android:text="LIVE" android:textColor="#F4F5F7" android:textSize="8sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="5dp" android:textAlignment="center" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
</LinearLayout>
