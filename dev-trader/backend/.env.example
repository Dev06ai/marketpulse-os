BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
SYMBOL=BTCUSDT
SNAPSHOT_SECONDS=1
MIN_RR=3
MAX_RISK_PCT=1
PUSH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
BITGET_DEMO_TRADING=false
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_MARGIN_MODE=isolated
# Preferred margin never overrides the 0.5% default / 1% hard equity risk cap.
BITGET_DEMO_MAX_PLANNED_LOSS_PCT=0.5
BITGET_DEMO_CONFIDENCE_MAX_NOTIONAL_USDT=2000
BITGET_DEMO_MAX_DAILY_TRADES=3
BITGET_EXECUTION_SYNC_SECONDS=5
BITGET_EXECUTION_STATE_FILE=/tmp/dev_trader_execution.json

# REQUIRED before activating private API and Android pairing; supply via hosting secret vault, not Git.
KYVORIQ_API_OWNER_TOKEN=
# Only needed if serving browser WebSockets from additional trusted HTTPS origins.
KYVORIQ_WS_ALLOWED_ORIGINS=
